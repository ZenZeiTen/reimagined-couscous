# ElevenLabs API key used by tools/audio/bake_sound_bank.mjs (offline baking).
ELEVENLABS_API_KEY=

# Optional, development only: lets the in-browser AudioManager generate
# missing sounds live during `vite dev`. Vite inlines VITE_* variables into
# the bundle, so production builds ignore this key and rely on the baked
# bank, the persistent cache and the procedural synth instead.
VITE_ELEVENLABS_API_KEY=
